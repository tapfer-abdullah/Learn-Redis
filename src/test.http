


GET http://localhost:5000/api/redis/banner

###
POST http://localhost:5000/api/redis/banner
content-type: application/json

{
  "bannerData": {
    "title": "Welcome to Our Website",
    "message": "Enjoy your stay and explore our features!"
  }
}

###
GET http://localhost:5000/api/redis/banner

###
DELETE http://localhost:5000/api/redis/banner

### 
GET http://localhost:5000/api/redis/banner/exists

### 
GET http://localhost:5000/api/redis/banner/ttl

###
POST http://localhost:5000/api/redis/banner/hash
content-type: application/json

{
  "key": "banner-hash",
  "value": {
    "age": 30,
    "title": "Welcome",
    "message": "Enjoy your stay and explore our features!"
  }
}


###
GET http://localhost:5000/api/redis/banner/hash/banner-hash

###
PUT http://localhost:5000/api/redis/banner/hash/update-title/banner-hash
content-type: application/json

{
  "title": "Updated Title fds"
}

