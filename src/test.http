#### otp -------------------------------->
POST http://localhost:5000/api/redis/otp
content-type: application/json

{
  "phoneNumber": "+1234567890"
}

####
GET http://localhost:5000/api/redis/otp/ttl/%2B1234567890

####
POST http://localhost:5000/api/redis/otp/verify
content-type: application/json

{
  "phoneNumber": "+1234567890",
  "otp": "771343"
}


